            if (viendoFavoritos) {
                btn.classList.add("activo");
                document.getElementById("zona-secciones").style.display = "none";
                document.getElementById("zona-busqueda").style.display = "none";
                document.getElementById("zona-vistos").style.display = "none";
                document.getElementById("zona-favoritos").style.display = "block";
                document.getElementById("id_buscador").value = "";
                renderFavoritos();
                window.scrollTo({ top: 0, behavior: "smooth" });
            } else {
                btn.classList.remove("activo");
                document.getElementById("zona-favoritos").style.display = "none";
                mostrarHome();
            }
        });

        // ── URL PARAMS ──
        function actualizarURL(titulo, temp = null, ep = null) {
            const params = new URLSearchParams();
            params.set("t", titulo);
            if (temp) params.set("temp", temp);
            if (ep) params.set("ep", ep);
            history.pushState({}, "", "?" + params.toString());
        }

        // ── VISTOS ──
        let VISTOS = JSON.parse(localStorage.getItem("cineplay_vistos") || "{}");
        let viendoVistos = false;

        function guardarVistos() {
            localStorage.setItem("cineplay_vistos", JSON.stringify(VISTOS));
        }

        function esVisto(titulo) { return !!VISTOS[titulo]; }

        function marcarVisto(titulo) {
            const d = DATA[titulo] || FAVORITOS[titulo];
            if (!d || VISTOS[titulo]) return;
            VISTOS[titulo] = d;
            guardarVistos();
            document.querySelectorAll(`.btn-visto[data-titulo="${titulo}"]`).forEach(b => {
                b.classList.add("activo");
                b.closest(".card-item")?.classList.add("visto");
            });
        }

        function toggleVisto(titulo, btnEl) {
            if (VISTOS[titulo]) {
                delete VISTOS[titulo];
                btnEl.classList.remove("activo");
                btnEl.closest(".card-item")?.classList.remove("visto");
            } else {
                const d = DATA[titulo] || FAVORITOS[titulo];
                if (d) VISTOS[titulo] = d;
                btnEl.classList.add("activo");
                btnEl.closest(".card-item")?.classList.add("visto");
            }
            guardarVistos();
            if (viendoVistos) renderVistos();
            document.querySelectorAll(`.btn-visto[data-titulo="${titulo}"]`).forEach(b => {
                b.classList.toggle("activo", !!VISTOS[titulo]);
                b.closest(".card-item")?.classList.toggle("visto", !!VISTOS[titulo]);
            });
        }

        function renderVistos() {
            const grid = document.getElementById("grid-vistos");
            grid.innerHTML = "";
            const items = Object.values(VISTOS);
            if (!items.length) {
                grid.innerHTML = `<div class="empty-state" style="width:100%">
                    <i class="bi bi-eye"></i>Todavía no marcaste nada como visto.<br>
                    <small>Se marca automáticamente cuando reproducís algo.</small>
                </div>`;
                return;
            }
            items.forEach(d => {
                const card = crearCard(d);
                card.style.flex = "0 0 125px";
                grid.appendChild(card);
            });
        }

        document.getElementById("btn-ver-vistos").addEventListener("click", () => {
            viendoVistos = !viendoVistos;
            const btn = document.getElementById("btn-ver-vistos");

            if (viendoVistos && viendoFavoritos) {
                viendoFavoritos = false;
                document.getElementById("btn-ver-favoritos").classList.remove("activo");
                document.getElementById("zona-favoritos").style.display = "none";
            }

            if (viendoVistos) {
                btn.classList.add("activo");
                document.getElementById("zona-secciones").style.display = "none";
                document.getElementById("zona-busqueda").style.display = "none";
                document.getElementById("zona-favoritos").style.display = "none";
                document.getElementById("zona-vistos").style.display = "block";
                document.getElementById("id_buscador").value = "";
                renderVistos();
                window.scrollTo({ top: 0, behavior: "smooth" });
            } else {
                btn.classList.remove("activo");
                document.getElementById("zona-vistos").style.display = "none";
                mostrarHome();
            }
        });

        // ── INFINITE SCROLL BÚSQUEDA ──
        const sentinel = document.getElementById("busqueda-sentinel");
        let observerActivo = false;

        const scrollObserver = new IntersectionObserver(async (entries) => {
            if (!entries[0].isIntersecting) return;
            if (busquedaPageActual >= busquedaTotalPages) return;
            if (!busquedaQuery) return;
            if (observerActivo) return;
            observerActivo = true;
            busquedaPageActual++;
            await iniciarBusqueda(busquedaQuery, busquedaPageActual);
            observerActivo = false;
        }, { threshold: 0.1 });

        scrollObserver.observe(sentinel);

        document.addEventListener('contextmenu', function (e) { e.preventDefault(); });
    </script>
    <script src="../bootstrap-5.3.3-dist/js/bootstrap.bundle.min.js" type="text/javascript"></script>
    <script src="../js/script-config.js"></script>
