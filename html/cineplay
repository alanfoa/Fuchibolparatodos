                    const img = a.querySelector("img")?.getAttribute("src") || "";
                    const titulo = a.querySelector(".listing-content p")?.innerText.trim() || "";
                    const val = a.querySelector(".stars span")?.innerText.replace(/[^\d.,]/g, "") || "N/A";
                    if (!titulo) return;
                    const tipo = link.includes("/serie/") || link.includes("/anime/") ? "serie" : "pelicula";
                    const d = { titulo, img, valoracion: val, link, tipo, seccion: "busqueda" };
                    DATA[titulo] = d;
                    items.push(d);
                });

                const pageLinks = doc.querySelectorAll(".pagination .page-item:not(.disabled) .page-link");
                let totalPages = 1;
                pageLinks.forEach(el => {
                    const n = parseInt(el.textContent.trim());
                    if (!isNaN(n) && n > totalPages) totalPages = n;
                });

                return { items, totalPages };
            } catch (e) {
                console.error("Error búsqueda:", e);
                return { items: [], totalPages: 1 };
            }
        }

        // Estado búsqueda
        let busquedaQuery = "";
        let busquedaPageActual = 1;
        let busquedaTotalPages = 1;

        async function iniciarBusqueda(q, page = 1) {
            busquedaQuery = q;
            busquedaPageActual = page;

            document.getElementById("zona-secciones").style.display = "none";
            document.getElementById("zona-busqueda").style.display = "block";
            document.getElementById("busqueda-query").textContent = q;

            const grid = document.getElementById("grid-busqueda");
            const sentinel = document.getElementById("busqueda-sentinel");

            if (page === 1) {
                grid.innerHTML = "";
                sentinel.style.display = "none";
                crearSkeletons(12, grid);
            }

            const { items, totalPages } = await fetchBusqueda(q, page);
            busquedaTotalPages = totalPages;

            if (page === 1) grid.innerHTML = "";

            if (items.length === 0 && page === 1) {
                grid.innerHTML = `<div class="empty-state" style="width:100%">
                    <i class="bi bi-search"></i>Sin resultados para "${q}"
                </div>`;
                sentinel.style.display = "none";
                return;
            }

            items.forEach(d => {
                const card = crearCard(d);
                card.style.flex = "0 0 125px";
                grid.appendChild(card);
            });

            sentinel.style.display = busquedaPageActual < busquedaTotalPages ? "block" : "none";
        }

        // ── CARDS ──
        function crearCard(d) {
            const div = document.createElement("div");
            div.className = "card-item" + (esVisto(d.titulo) ? " visto" : "");
            div.title = d.titulo;
            const tipoConfig = {
                pelicula: { clase: "film", label: "Película" },
                serie: { clase: "serie", label: "Serie" },
                anime: { clase: "anime", label: "Anime" },
                dorama: { clase: "dorama", label: "Dorama" },
            };
            const cfg = tipoConfig[d.tipo] || { clase: "film", label: d.tipo };
            const favActivo = esFavorito(d.titulo) ? "activo" : "";
            const vistoActivo = esVisto(d.titulo) ? "activo" : "";

            div.innerHTML = `
                <span class="card-type-badge ${cfg.clase}">${cfg.label}</span>
                <button class="btn-fav ${favActivo}" title="Favorito" data-titulo="${d.titulo}">
                    <i class="bi bi-star-fill"></i>
                </button>
                <button class="btn-visto ${vistoActivo}" title="Marcar como visto" data-titulo="${d.titulo}">
                    <i class="bi bi-eye-fill"></i>
                </button>
                <div class="card-visto-badge">VISTO</div>
                <img class="card-poster" src="${d.img}" loading="lazy" alt="${d.titulo}"
                     onerror="this.src='https://via.placeholder.com/140x210/0e1219/6b7a8d?text=Sin+imagen'">
                <div class="card-overlay">
                    <div class="play-btn"><i class="bi bi-play-fill"></i></div>
                </div>
                <div class="card-info">
                    <div class="card-title">${d.titulo}</div>
                    <div class="card-rating"><i class="bi bi-star-fill"></i> ${d.valoracion}</div>
                </div>`;

            div.querySelector(".btn-fav").addEventListener("click", e => {
                e.stopPropagation();
                toggleFavorito(d.titulo, e.currentTarget);
            });

            div.querySelector(".btn-visto").addEventListener("click", e => {
                e.stopPropagation();
                toggleVisto(d.titulo, e.currentTarget);
            });

            div.addEventListener("click", () => seleccionar(d.titulo));
            return div;
        }

        function crearSkeletons(n, container) {
            for (let i = 0; i < n; i++) {
