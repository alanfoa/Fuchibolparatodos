                });
                document.addEventListener('mouseup', () => {
                    if (!isDown) return;
                    isDown = false;
                    el.style.cursor = 'grab';
                    document.body.style.cursor = '';
                });
                document.addEventListener('mousemove', e => {
                    if (!isDown) return;
                    el.scrollLeft = scrollLeft - (e.clientX - startX);
                });
            });
        }

