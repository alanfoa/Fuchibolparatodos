        // ═══════════════════════════════════════════════════════════
        // ── NUEVO SISTEMA DE DESCIFRADO AES + PoW ──
        // ═══════════════════════════════════════════════════════════

        async function sha256hex(str) {
            const buf = await crypto.subtle.digest('SHA-256', new TextEncoder().encode(str));
            return Array.from(new Uint8Array(buf))
                .map(b => b.toString(16).padStart(2, '0')).join('');
        }

        async function resolverPoW(challenge, difficulty, salt) {
            const prefix = '0'.repeat(difficulty);
            let nonce = 0;
            while (true) {
                // Procesar en lotes para no bloquear el hilo
                for (let i = 0; i < 500; i++) {
                    const hash = await sha256hex(challenge + nonce);
                    if (hash.startsWith(prefix)) {
                        const keyBuf = await crypto.subtle.digest('SHA-256',
                            new TextEncoder().encode(challenge + nonce + salt));
                        return new Uint8Array(keyBuf);
                    }
                    nonce++;
                }
                // Ceder el hilo brevemente cada 500 intentos
                await new Promise(r => setTimeout(r, 0));
            }
        }

        async function decryptAES(encryptedBase64, aesKey) {
            try {
                const raw = Uint8Array.from(atob(encryptedBase64), c => c.charCodeAt(0));
                const iv = raw.slice(0, 16);
                const ciphertext = raw.slice(16);
                const key = await crypto.subtle.importKey(
                    'raw', aesKey.slice(0, 32), { name: 'AES-CBC' }, false, ['decrypt']
                );
                const decrypted = await crypto.subtle.decrypt({ name: 'AES-CBC', iv }, key, ciphertext);
                return new TextDecoder().decode(decrypted);
            } catch { return null; }
        }

        // Intento de formato legacy (antes del AES): base64 JWT-like
        function parsearDataLinkLegacy(dl) {
            const out = {};
            dl.forEach(entry => {
                const idioma = entry.video_language;
                out[idioma] = [];
                (entry.sortedEmbeds || []).forEach(embed => {
                    try {
                        const decoded = JSON.parse(atob(embed.link.split(".")[1]));
                        if (decoded.link) out[idioma].push({ servidor: embed.servername, url: decoded.link });
                    } catch { }
                });
            });
            return out;
        }

        async function descifrarDataLink(dl, aesKey) {
            const out = {};
            for (const entry of dl) {
                const idioma = entry.video_language;
                out[idioma] = [];
                for (const embed of (entry.sortedEmbeds || [])) {
                    if (!embed.link || typeof embed.link !== 'string') continue;
                    const decrypted = await decryptAES(embed.link, aesKey);
                    if (decrypted && decrypted.startsWith('http')) {
                        out[idioma].push({ servidor: embed.servername, url: decrypted.trim() });
                    }
                }
            }
            return out;
        }

        /**
         * Parsea el HTML de embed69 detectando automáticamente
         * si usa el nuevo sistema AES+PoW o el legacy base64.
         */
        async function parsearDataLink(html) {
            // Extraer array dataLink
            const m = html.match(/(?:let|const|var)\s+dataLink\s*=\s*(\[[\s\S]*?\]);/);
            if (!m) return {};

            let dl;
            try { dl = JSON.parse(m[1]); } catch { return {}; }
            if (!dl.length) return {};

            // Detectar si hay PoW (nuevo sistema)
            const chalM = html.match(/POW_CHALLENGE\s*=\s*['"]([^'"]+)['"]/);
            const diffM = html.match(/POW_DIFFICULTY\s*=\s*(\d+)/);
            const saltM = html.match(/POW_SALT\s*=\s*['"]([^'"]+)['"]/);

            if (chalM && saltM) {
                // ── NUEVO SISTEMA: AES-256-CBC con clave derivada por PoW ──
                const challenge = chalM[1];
                const difficulty = parseInt(diffM?.[1] || "3");
                const salt = saltM[1];

                // mostrarPowLoader(`Resolviendo PoW (dificultad ${difficulty})…`);
                const aesKey = await resolverPoW(challenge, difficulty, salt);
                // mostrarPowLoader('Descifrando servidores…');
                const resultado = await descifrarDataLink(dl, aesKey);
                // ocultarPowLoader();
                return resultado;
            } else {
                // ── SISTEMA LEGACY: JWT base64 ──
                return parsearDataLinkLegacy(dl);
            }
        }

