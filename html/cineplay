        // ── SERIES ──
        async function cargarTemporadas(d) {
            if (!SeriesCache[d.link]) {
                document.getElementById("zona-episodios").style.display = "block";
                document.getElementById("ep-serie-titulo").textContent = "Cargando…";
                document.getElementById("select-temporada").innerHTML = "";
                document.getElementById("ep-count").textContent = "";
                document.getElementById("grid-episodios").innerHTML = `<div style="color:var(--text-muted);font-size:.85rem">Buscando episodios…</div>`;
                const temporadas = await obtenerTemporadasSerie(d.link);
                SeriesCache[d.link] = temporadas;
            }

            const temporadas = SeriesCache[d.link];
            mostrarEpisodios(d, temporadas, 1);
        }

        async function obtenerTemporadasSerie(link) {
            try {
                const res = await fetchConProxy(link);
                const html = await res.text();
                const doc = new DOMParser().parseFromString(html, "text/html");
                const temporadas = {};

                doc.querySelectorAll(".TbVideoNv li a[data-toggle='tab']").forEach(tab => {
                    const m = tab.textContent.trim().match(/TEMPORADA\s+(\d+)/i);
                    if (!m) return;
                    const n = parseInt(m[1]);
                    const pid = tab.getAttribute("href")?.replace("#", "").trim();
                    if (!pid) return;
                    const panel = doc.querySelector(`#${pid}`);
                    if (!panel) return;

                    const eps = [];
                    panel.querySelectorAll("a.btn[href*='/temporada/']").forEach(a => {
                        const txt = a.textContent.trim();
                        const em = txt.match(/E(\d+):\s*(.+)/i);
                        if (!em) return;
                        eps.push({ numero: parseInt(em[1]), titulo: em[2].trim(), link: a.getAttribute("href") });
                    });

                    if (eps.length) temporadas[`Temporada ${n}`] = eps;
                });

                return temporadas;
            } catch (e) {
                console.error("Error temporadas:", e);
                return {};
            }
        }

        let episodiosActuales = [];
        let serieActual = null;

        function mostrarEpisodios(d, temporadas, numTemp) {
            temporadaActual = numTemp;
            serieActual = d;
            const keys = Object.keys(temporadas);
            if (!keys.length) {
                document.getElementById("ep-serie-titulo").textContent = "Sin episodios";
                document.getElementById("grid-episodios").innerHTML = "";
                document.getElementById("select-temporada").innerHTML = "";
                return;
            }

            document.getElementById("zona-episodios").style.display = "block";
            document.getElementById("ep-serie-titulo").textContent = d.titulo;

            const sel = document.getElementById("select-temporada");
            sel.innerHTML = keys.map((k, i) =>
                `<option value="${i + 1}" ${i + 1 === numTemp ? "selected" : ""}>${k}</option>`
            ).join("");
            sel.onchange = () => mostrarEpisodios(d, temporadas, parseInt(sel.value));

            const btnPrev = document.getElementById("btn-temp-prev");
            const btnNext = document.getElementById("btn-temp-next");
            btnPrev.disabled = numTemp <= 1;
            btnNext.disabled = numTemp >= keys.length;
            btnPrev.onclick = () => mostrarEpisodios(d, temporadas, numTemp - 1);
            btnNext.onclick = () => mostrarEpisodios(d, temporadas, numTemp + 1);

            episodiosActuales = temporadas[`Temporada ${numTemp}`] || [];
            document.getElementById("ep-count").textContent = `${episodiosActuales.length} ep.`;

            const grid = document.getElementById("grid-episodios");
            grid.innerHTML = "";
            episodiosActuales.forEach(ep => {
                const btn = document.createElement("button");
                btn.className = "btn-ep";
                btn.id = `btn-ep-${ep.numero}`;
                btn.textContent = `E${String(ep.numero).padStart(2, "0")}`;
                btn.setAttribute("data-titulo", ep.titulo);
                btn.title = ep.titulo;
                btn.addEventListener("click", () => reproducirEpisodio(d, ep, numTemp));
                grid.appendChild(btn);
            });

            actualizarZappingEpisodios(null);
        }

        function actualizarZappingEpisodios(epNumero) {
            const idx = episodiosActuales.findIndex(e => e.numero === epNumero);
            const btnPrev = document.getElementById("btn-ep-prev");
            const btnNext = document.getElementById("btn-ep-next");
            const temporadas = SeriesCache[serieActual?.link];
            const keys = temporadas ? Object.keys(temporadas) : [];
            const totalTemporadas = keys.length;

            if (idx === -1) {
                btnPrev.disabled = true;
                btnNext.disabled = true;
                return;
            }

            const ep = episodiosActuales[idx];
            const esUltimoCap = idx >= episodiosActuales.length - 1;
            const esPrimerCap = idx <= 0;
            const hayTempSiguiente = temporadaActual < totalTemporadas;
            const hayTempAnterior = temporadaActual > 1;

            btnNext.disabled = esUltimoCap && !hayTempSiguiente;
            if (esUltimoCap && hayTempSiguiente) {
                btnNext.title = `Ir a Temporada ${temporadaActual + 1}`;
                btnNext.style.borderColor = "var(--accent)";
                btnNext.style.color = "var(--accent)";
                btnNext.onclick = () => {
                    const siguienteTemp = temporadaActual + 1;
                    const eps = temporadas[`Temporada ${siguienteTemp}`] || [];
                    if (!eps.length) return;
                    mostrarEpisodios(serieActual, temporadas, siguienteTemp);
                    reproducirEpisodio(serieActual, eps[0], siguienteTemp);
                };
            } else {
                btnNext.title = "Episodio siguiente";
                btnNext.style.borderColor = "";
                btnNext.style.color = "";
                btnNext.onclick = () => reproducirEpisodio(serieActual, episodiosActuales[idx + 1], temporadaActual);
            }

            btnPrev.disabled = esPrimerCap && !hayTempAnterior;
            if (esPrimerCap && hayTempAnterior) {
                btnPrev.title = `Ir a Temporada ${temporadaActual - 1}`;
                btnPrev.style.borderColor = "var(--accent)";
                btnPrev.style.color = "var(--accent)";
                btnPrev.onclick = () => {
                    const anteriorTemp = temporadaActual - 1;
                    const eps = temporadas[`Temporada ${anteriorTemp}`] || [];
                    if (!eps.length) return;
                    mostrarEpisodios(serieActual, temporadas, anteriorTemp);
                    reproducirEpisodio(serieActual, eps[eps.length - 1], anteriorTemp);
                };
            } else {
                btnPrev.title = "Episodio anterior";
                btnPrev.style.borderColor = "";
                btnPrev.style.color = "";
                btnPrev.onclick = () => reproducirEpisodio(serieActual, episodiosActuales[idx - 1], temporadaActual);
            }

            document.querySelectorAll(".btn-ep").forEach(b => b.classList.remove("active"));
            document.getElementById(`btn-ep-${ep.numero}`)?.classList.add("active");
            document.getElementById(`btn-ep-${ep.numero}`)
                ?.scrollIntoView({ behavior: "smooth", block: "nearest", inline: "center" });
        }

        async function reproducirEpisodio(d, ep, numTemp) {
            episodioActual = ep.numero;
            actualizarURL(d.titulo, numTemp, ep.numero);
            MostrarPlayer();
            document.getElementById("id_PantallaTV").src = "";
            document.getElementById("player-title-txt").textContent = `${d.titulo} — T${numTemp} E${ep.numero}`;
            document.getElementById("id_optServidores").innerHTML = "<option>Cargando…</option>";

            actualizarZappingEpisodios(ep.numero);

            const servidores = await obtenerServidoresEpisodio(ep.link);
            const lista = aplanarServidores(servidores);

            if (!lista.length) {
                document.getElementById("player-title-txt").textContent = "Sin servidores disponibles";
                document.getElementById("id_optServidores").innerHTML = "<option>—</option>";
                return;
            }

            servidoresActuales = servidores;
            poblarSelect(lista);
            marcarVisto(d.titulo);
            document.getElementById("id_PantallaTV").src = lista[0].url;
            window.scrollTo({ top: 0, behavior: "smooth" });
        }

        async function obtenerServidoresEpisodio(link) {
            try {
                const res = await fetchConProxy(link);
                const html = await res.text();
                const m = html.match(/video\[1\]\s*=\s*['"]([^'"]+)['"]/);
                if (!m) return {};

                const resE = await fetchConProxy(m[1]);
                const htmlE = await resE.text();

                // ← ACTUALIZADO: soporta AES y legacy
                return await parsearDataLink(htmlE);
            } catch (e) {
                console.error("Error servidores episodio:", e);
                ocultarPowLoader();
                return {};
            }
        }

        // ── UTILIDADES ──
        function aplanarServidores(servidores) {
            const lista = [];
            const etq = { LAT: "Latino", SUB: "Subtitulado", ESP: "Español", JAP: "Japonés", ENG: "Inglés" };
            for (const idioma in servidores) {
                servidores[idioma].forEach(s => {
                    lista.push({ nombre: `${s.servidor} (${etq[idioma] || idioma})`, url: s.url });
                });
            }
            return lista;
        }

        function poblarSelect(lista) {
            const sel = document.getElementById("id_optServidores");
            sel.innerHTML = "";
            lista.forEach((s, i) => {
                const opt = document.createElement("option");
                opt.value = i;
                opt.textContent = s.nombre;
                sel.appendChild(opt);
            });
        }

        document.getElementById("id_optServidores").addEventListener("change", function () {
            const lista = aplanarServidores(servidoresActuales);
            const idx = parseInt(this.value);
            if (lista[idx]) document.getElementById("id_PantallaTV").src = lista[idx].url;
        });

        function MostrarPlayer() {
            document.getElementById("zona-player").style.display = "block";
            document.getElementById("player-bar").classList.add("visible");
        }

        function CerrarPlayer() {
            document.getElementById("zona-player").style.display = "none";
            document.getElementById("player-bar").classList.remove("visible");
            document.getElementById("id_PantallaTV").src = "";
        }

        function CerrarEpisodios() {
            document.getElementById("zona-episodios").style.display = "none";
        }

        // ── BACK TO TOP ──
        window.addEventListener("scroll", () => {
            document.getElementById("backToTop").classList.toggle("visible", window.scrollY > 300);
        });

        // ── DRAG TO SCROLL ──
        document.querySelectorAll('.scroll-row').forEach(el => {
            let isDown = false, startX, scrollLeft;
            el.addEventListener('mousedown', e => {
                isDown = true;
                el.style.cursor = 'grabbing';
                startX = e.pageX - el.offsetLeft;
                scrollLeft = el.scrollLeft;
                e.preventDefault();
            });
            el.addEventListener('mouseleave', () => { isDown = false; el.style.cursor = 'grab'; });
            el.addEventListener('mouseup', () => { isDown = false; el.style.cursor = 'grab'; });
            el.addEventListener('mousemove', e => {
                if (!isDown) return;
                const x = e.pageX - el.offsetLeft;
                el.scrollLeft = scrollLeft - (x - startX) * 1.5;
            });
        });

        // ── FAVORITOS ──
        let FAVORITOS = JSON.parse(localStorage.getItem("cineplay_favoritos") || "{}");
        let viendoFavoritos = false;

        function guardarFavoritos() {
            localStorage.setItem("cineplay_favoritos", JSON.stringify(FAVORITOS));
        }

        function esFavorito(titulo) { return !!FAVORITOS[titulo]; }

        function toggleFavorito(titulo, btnEl) {
            if (FAVORITOS[titulo]) {
                delete FAVORITOS[titulo];
                btnEl.classList.remove("activo");
            } else {
                const d = DATA[titulo];
                if (d) FAVORITOS[titulo] = d;
                btnEl.classList.add("activo");
            }
            guardarFavoritos();
            if (viendoFavoritos) renderFavoritos();
            document.querySelectorAll(`.btn-fav[data-titulo="${titulo}"]`).forEach(b => {
                b.classList.toggle("activo", !!FAVORITOS[titulo]);
            });
        }

        function renderFavoritos() {
            const grid = document.getElementById("grid-favoritos");
            grid.innerHTML = "";
            const items = Object.values(FAVORITOS);

            if (!items.length) {
                grid.innerHTML = `<div class="empty-state" style="width:100%">
                    <i class="bi bi-star"></i>Todavía no tenés favoritos.<br>
                    <small>Tocá la ⭐ en cualquier película o serie.</small>
                </div>`;
