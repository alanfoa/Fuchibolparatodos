    <main class="col-12  text-center">
        <div class="d-flex justify-content-center gap-2 p-2 bg-dark">
            <button id="btnEventos" class="btn btn-success fw-bold active" onclick="mostrarSeccion('eventos')">
                📅 Agenda Deportiva
            </button>
            <button id="btnMundial" class="btn btn-outline-warning fw-bold" onclick="mostrarSeccion('mundial')">
                🏆 Mundial 2026
            </button>
        </div>

        <div id="seccionEventos">
            <iframe class="col-12 col-md-12 rounded" style="height: 25em; background-color: white;" src="miAgenda.html"
                title="" frameborder="0" scrolling="0"
                allow="accelerometer; muted; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe>
        </div>

        <div id="seccionMundial" style="display:none;">
            <iframe class="col-12 col-md-12 rounded" style="height: 25em; background-color: white;"
                src="mundial2026.html" title="" frameborder="0" scrolling="0"
                allow="accelerometer; muted; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe>
        </div>

        <h2 class="text-light text-center p-2 rounded" style="background-color: #2196F3;">Guía para Canales</h2>
        <!-- <a href="/html/guia" class="btn btn-primary btn-lg" target="_blank">
            Ver canales de la grilla
        </a> -->
        <section style="overflow: hidden;">
            <!-- <iframe class="col-11 m-1 rounded mb-5" style="height: 500em; background-color: white;"
                src="guiaCanales.html" title="" frameborder="0" scrolling="0"
                allow="accelerometer; muted; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe> -->
            <iframe id="iframeAuto" class="col-12 rounded mb-5" src="miProgramacion.html" title="" frameborder="0"
                scrolling="0"
                allow="accelerometer; muted; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe>
        </section>
    </main>






    <script>
        window.addEventListener('message', (e) => {
            if (e.data?.tipo === 'ajustar-iframe') {
                const iframe = document.getElementById('iframeAuto');
                iframe.style.height = e.data.altura + 'px';
            }
        });
    </script>


    <script src="../js/script-config.js"></script>
    <script src="../bootstrap-5.3.3-dist/js/bootstrap.bundle.min.js" type="text/javascript"></script>
    <script type='text/javascript'>document.oncontextmenu = function () { return false; }</script>
    <script>
        function mostrarSeccion(seccion) {
            const esEventos = seccion === 'eventos';
            document.getElementById('seccionEventos').style.display = esEventos ? 'block' : 'none';
            document.getElementById('seccionMundial').style.display = esEventos ? 'none' : 'block';
            document.getElementById('btnEventos').className = `btn fw-bold ${esEventos ? 'btn-success' : 'btn-outline-success'}`;
            document.getElementById('btnMundial').className = `btn fw-bold ${esEventos ? 'btn-outline-warning' : 'btn-warning'}`;

        }

        document.addEventListener('contextmenu', function (e) {
            e.preventDefault();
        });
    </script>

