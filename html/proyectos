    <style>
        body {
            background-color: #0d1117;
            min-height: 100vh;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        .main-title {
            color: #e6edf3;
            font-size: 2.5rem;
            font-weight: 600;
            margin-bottom: 1rem;
        }

        .subtitle {
            color: #8b949e;
            font-size: 1.1rem;
            margin-bottom: 0;
        }

        /* Cards básicas y limpias */
        .option-card {
            background-color: #21262d;
            border: 1px solid #30363d;
            border-radius: 12px;
            overflow: hidden;
            transition: all 0.3s ease;
            height: 100%;
            cursor: pointer;
            text-decoration: none;
            color: inherit;
        }

        .option-card:hover {
            color: inherit;
            text-decoration: none;
            transform: translateY(-5px);
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.3);
            border-color: #58a6ff;
        }

        .card-image {
            height: 200px;
            object-fit: cover;
            transition: transform 0.3s ease;
        }

        .option-card:hover .card-image {
            transform: scale(1.05);
        }

        .card-body {
            padding: 1.5rem;
        }

        .card-title {
            font-size: 1.2rem;
            font-weight: 600;
            margin-bottom: 1rem;
            display: flex;
            align-items: center;
            color: #e6edf3;
        }

        .card-title i {
            font-size: 1.3rem;
            margin-right: 0.5rem;
            color: #58a6ff;
        }

        .card-text {
            color: #8b949e;
            line-height: 1.5;
            margin-bottom: 0;
            font-size: 0.9rem;
        }

        /* Badge simple */
        .badge-new {
            position: absolute;
            top: 12px;
            right: 12px;
            background-color: #f85149;
            color: white;
            padding: 0.3rem 0.7rem;
            border-radius: 15px;
            font-size: 0.75rem;
            font-weight: 600;
            text-transform: uppercase;
            z-index: 2;
        }

        /* VIP Card - mantenemos el estilo que te gusta */
        .vip-card {
            position: relative;
            cursor: not-allowed;
        }

        .vip-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 15px 30px rgba(255, 193, 7, 0.2);
        }

        .vip-overlay {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            z-index: 3;
            text-align: center;
        }

        .lock-icon {
            font-size: 3.5rem;
            color: #ffc107;
            text-shadow: 0 0 25px rgba(255, 193, 7, 0.6);
            animation: pulse 2.5s infinite;
            filter: drop-shadow(0 0 10px rgba(255, 193, 7, 0.4));
        }

        @keyframes pulse {

            0%,
            100% {
                transform: scale(1);
                opacity: 1;
            }

            50% {
                transform: scale(1.15);
                opacity: 0.8;
            }
        }

        .vip-card .card-image {
            filter: brightness(0.25) saturate(0.4) blur(1px);
        }

        .vip-card:hover .card-image {
            filter: brightness(0.3) saturate(0.5) blur(0.5px);
        }

        /* Footer info simple */
        .footer-info {
            background-color: #21262d;
            border: 1px solid #30363d;
            border-radius: 12px;
            padding: 1.5rem;
            margin-top: 3rem;
        }

        .footer-info p {
            margin: 0;
            color: #8b949e;
            font-size: 1rem;
        }

        .footer-info i {
            color: #58a6ff;
        }

        /* Responsive */
        @media (max-width: 768px) {
            .main-title {
                font-size: 2rem;
            }

            .card-body {
                padding: 1.2rem;
            }
        }
    </style>
